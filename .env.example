FALKORDB_HOST=
FALKORDB_PORT=
# 1 only when running behind our own reverse proxy (Caddy / Cloudflare)
TRUST_PROXY=
# Optional: defaults to Google Gemini OpenAI-compatible endpoint
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Optional: if omitted, Lore answers directly from graph with no LLM
LLM_API_KEY=
# Optional: defaults to gemini-3.8-flash
LLM_MODEL=gemini-3.8-flash
# Practice repo for the Approve demo (never a kubernetes/ repo)
DEMO_REPO=Laimos-code/lore-demo-issues
# Fine-grained token: only lore-demo-issues, Issues read/write
DEMO_GITHUB_TOKEN=
# Only this GitHub owner's repos may be acted on (default Laimos-code); kubernetes* is always refused
DEMO_REPO_OWNER=Laimos-code
# Optional: require this passcode (X-Approve-Passcode header) for the Approve button
APPROVE_PASSCODE=
# Max approved posts per day (default 50)
APPROVE_DAILY_CAP=
# Comma-separated other sites allowed to call the API from a browser (empty = none)
ALLOWED_ORIGINS=
# 1 = every tool returns the old fixed example answers (demo without a loaded graph)
USE_STUBS=
# Only for scripts/fetch_github.py (downloading PRs and issues); the server doesn't use it
GITHUB_TOKEN=

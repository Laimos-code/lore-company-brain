FALKORDB_HOST=
FALKORDB_PORT=
# 1 only when running behind our own reverse proxy (Caddy / Cloudflare)
TRUST_PROXY=
# Optional: defaults to Google Gemini OpenAI-compatible endpoint
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Optional: if omitted, Lore answers directly from graph with no LLM
LLM_API_KEY=
# Optional: defaults to gemini-3.8-flash
LLM_MODEL=gemini-3.8-flash
